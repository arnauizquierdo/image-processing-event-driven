# BUILD - Fase 1
FROM maven:3.9-eclipse-temurin-25 AS build

WORKDIR /app

# copy root and POMs
COPY pom.xml .
COPY image-processing-core/pom.xml image-processing-core/pom.xml
COPY image-processing-api/pom.xml image-processing-api/pom.xml
COPY image-processing-worker/pom.xml image-processing-worker/pom.xml

# copy source code
COPY image-processing-core/src image-processing-core/src
COPY image-processing-api/src image-processing-api/src
COPY image-processing-worker/src image-processing-worker/src

# compile API and its required dependencies (core)
RUN mvn -B -pl image-processing-api -am clean package -DskipTests


# RUNTIME - Fase 2
FROM eclipse-temurin:25-jre

WORKDIR /app

# copy the API executable JAR from the build stage into the runtime image as app.jar
COPY --from=build /app/image-processing-api/target/image-processing-api-*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]